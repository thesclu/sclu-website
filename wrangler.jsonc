{
  // Pure static-asset deploy -- no server, no SSR, no OpenNext adapter.
  //
  // Without this file, Cloudflare auto-detects "Next.js" and routes the
  // build through @opennextjs/cloudflare, which expects a full SSR build
  // (next build with output: "standalone") and fails looking for
  // .next/standalone/.next/server/pages-manifest.json -- a file that only
  // exists for SSR builds, not the static export this repo produces
  // (next.config.mjs has output: "export", building to /out).
  //
  // The form currently posts straight to FormSubmit from the browser
  // (see components/GetSupportForm.jsx), so no server-side code runs at
  // all right now. functions/api/get-support.js sits unused until a real
  // backend replaces FormSubmit -- wiring that up later will need actual
  // Worker routing added here, not just this file.
  "name": "sclu-website",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "out"
  }
}
